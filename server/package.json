{
  "name": "easypharma-server",
  "version": "1.0.0",
  "description": "EasyPharma backend API",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/db/migrate.js && node src/index.js",
