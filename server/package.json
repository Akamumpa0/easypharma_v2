    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.41.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nanoid": "^6.0.0",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.3.0",
